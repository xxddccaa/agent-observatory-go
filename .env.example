# Optional environment overrides for agent-observatory-go
# Copy to .env only for local development; packaged binary works zero-config.

# Override data directory (default: ~/.agent-observatory-go on Unix, %LocalAppData%\agent-observatory-go on Windows)
# AGENT_OBS_HOME=

# HTTP listen address (default: 127.0.0.1:8125)
# AGENT_OBS_LISTEN=127.0.0.1:8125

# Comma-separated extra allowed Host names for reverse proxy access (use * carefully)
# AGENT_OBS_ALLOWED_HOSTS=

# Extra read-only agent data roots (format: agent:path,agent2:path2)
# AGENT_OBS_EXTRA_ROOTS=
