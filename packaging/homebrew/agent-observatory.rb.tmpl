class AgentObservatory < Formula
  desc "Local-first, read-only multi-agent coding session observatory"
  homepage "https://github.com/agent-observatory/agent-observatory-go"
  version "{{VERSION}}"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/agent-observatory/agent-observatory-go/releases/download/v{{VERSION}}/agent-observatory_{{VERSION}}_darwin_arm64.tar.gz"
      sha256 "{{SHA256_DARWIN_ARM64}}"
    else
      url "https://github.com/agent-observatory/agent-observatory-go/releases/download/v{{VERSION}}/agent-observatory_{{VERSION}}_darwin_amd64.tar.gz"
      sha256 "{{SHA256_DARWIN_AMD64}}"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/agent-observatory/agent-observatory-go/releases/download/v{{VERSION}}/agent-observatory_{{VERSION}}_linux_arm64.tar.gz"
      sha256 "{{SHA256_LINUX_ARM64}}"
    else
      url "https://github.com/agent-observatory/agent-observatory-go/releases/download/v{{VERSION}}/agent-observatory_{{VERSION}}_linux_amd64.tar.gz"
      sha256 "{{SHA256_LINUX_AMD64}}"
    end
  end

  def install
    bin.install "agent-observatory"
    bin.install_symlink "agent-observatory" => "aobs"
  end

  def caveats
    <<~EOS
      Run `aobs` (or `agent-observatory`) to start the single-instance local daemon and open http://127.0.0.1:8125.
      Run `aobs --foreground` to run in the foreground without detaching.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/agent-observatory --version")
    assert_match version.to_s, shell_output("#{bin}/aobs --version")
  end
end
